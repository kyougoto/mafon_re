/*
 * config.h for building mpg123 1.32.10 (libmpg123 core only) with the
 * Android NDK, generic C decoders (no SIMD/assembly).
 *
 * Generated by native/CMakeLists.txt from native/cmake/config-mpg123.h.in.
 * This mirrors the feature set that mpg123's own autotools/CMake build would
 * pick on Android for the given ABI:
 *   - IEEE 754 float storage (REAL_IS_FLOAT is given on the compiler command
 *     line together with OPT_GENERIC)
 *   - 64 bit off_t (aarch64 native; on 32 bit ABIs _FILE_OFFSET_BITS=64 is set)
 *   - gapless decoding + frame index (seek support)
 *   - all three MPEG layers and all output formats enabled (no NO_* macros)
 *   - no network / no libout123 / no locale-specific transcoding extras
 */
#ifndef MPG123_CONFIG_H
#define MPG123_CONFIG_H

#define PACKAGE_NAME "mpg123"
#define PACKAGE_VERSION "1.32.10"
#define PACKAGE_STRING "mpg123 1.32.10"
#define PACKAGE_TARNAME "mpg123"
#define VERSION "1.32.10"

/* off_t width as seen by the compiler. 8 on all Android ABIs we target
 * (either native or forced via _FILE_OFFSET_BITS=64). */
#define SIZEOF_OFF_T @MPG123_SIZEOF_OFF_T@

/* IEEE 754 float storage: enables the fast generic 16 bit rounding path. */
#define IEEE_FLOAT 1

/* Gapless decoding and the frame index seek table. */
#define GAPLESS 1
#define FRAME_INDEX 1
#define INDEX_SIZE 1000

/* Integer output rounding instead of fast truncation. */
#define ACCURATE_ROUNDING 1

/* Assembler alignment hints (only used for the optional .S decoders). */
#define ASMALIGN_BALIGN 1
#define CCALIGN 1

/* New (Taihei) Huffman decoding tables: faster on modern CPUs. */
#define USE_NEW_HUFFTABLE 1

/* libc / headers available on Android (bionic) for all supported API levels. */
#define HAVE_ATOLL 1
#define HAVE_DIRENT_H 1
#define HAVE_DLFCN_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_LOCALE_H 1
#define HAVE_SETLOCALE 1
#define HAVE_SIGNAL_H 1
#define HAVE_STRERROR 1
#define HAVE_STRINGS_H 1
#define HAVE_SYS_SELECT_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TIME_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_UNISTD_H 1

/* Not used by libmpg123 core; kept for source compatibility. */
#define DEFAULT_OUTPUT_MODULE "dummy"
#define LT_MODULE_EXT ".so"

/*
 * Intentionally NOT defined:
 *   PORTABLE_API      -> keep the off_t based API (mpg123_open etc.)
 *   NO_LAYER1/2/3     -> decode all MPEG audio layers
 *   NO_8BIT/16BIT/32BIT/REAL -> all output formats available
 *   NO_NTOM, NO_DOWNSAMPLE, NO_ICY, NO_ID3V2, NO_STRING, NO_FEEDER
 *   HAVE_NL_LANGINFO, HAVE_USELOCALE, HAVE_STRERROR_L
 *                     -> not guaranteed on API 21, libmpg123 falls back
 *   NETWORK, FIFO, USE_MODULES
 *   WORDS_BIGENDIAN   -> little endian targets only
 */

#endif /* MPG123_CONFIG_H */
